# ==============================================================================
# REBOOTX — Self-Hosted Production & Development Environment Configuration
# ==============================================================================
# Copy this file to .env or run: python scripts/setup.py
# NEVER commit .env with actual credentials to version control.
# ==============================================================================

# Application environment (development | production | test)
APP_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=rebootx
# Set a strong, random password. Generated automatically by scripts/setup.py.
POSTGRES_PASSWORD=
POSTGRES_DB=rebootx
POSTGRES_PORT=5432

# Database connection URL used by backend, worker, dispatcher, and Alembic.
# For Docker Compose, the host is 'postgres'. For local host dev, use 'localhost'.
DATABASE_URL=postgresql+psycopg://rebootx:${POSTGRES_PASSWORD}@postgres:5432/rebootx

# ------------------------------------------------------------------------------
# Ingestion & Webhook Security
# ------------------------------------------------------------------------------
# Shared HMAC signing secret between n8n Error Trigger and REBOOTX backend.
# Must be at least 32 characters. Generated automatically by scripts/setup.py.
N8N_WEBHOOK_SECRET=

# Read token used to authenticate frontend dashboard operators.
# Held only in browser memory and validated via hash lookup on the backend.
# Must be at least 32 characters. Generated automatically by scripts/setup.py.
TENANT_READ_TOKEN=

# Maximum allowed clock skew for HMAC timestamps (seconds)
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Maximum accepted webhook payload size in bytes (64 KB default)
MAX_WEBHOOK_BODY_BYTES=65536

# ------------------------------------------------------------------------------
# Temporal Orchestration Engine
# ------------------------------------------------------------------------------
# For Docker Compose, use 'temporal:7233'. For local standalone server, use '127.0.0.1:7233'.
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=rebootx-recovery-v1
TEMPORAL_TLS_ENABLED=false
TEMPORAL_API_KEY=

# ------------------------------------------------------------------------------
# AI Advisory Diagnosis (Google Gemma / Gemini)
# ------------------------------------------------------------------------------
# 'mock' (default; zero external API calls) or 'gemma' (opt-in hosted Gemma inference)
AI_PROVIDER=mock
AI_MODEL=gemma-4-26b-a4b-it
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_FALLBACK_ENABLED=true
AI_MIN_CONFIDENCE=0.75
AI_FAST_PATH_ENABLED=true
AI_MAX_OUTPUT_TOKENS=1024
AI_THINKING_LEVEL=default

# ------------------------------------------------------------------------------
# Recovery Safety & n8n Integration
# ------------------------------------------------------------------------------
# Safe default is 'mock-only'. Real recovery actions REQUIRE explicit authorization.
RECOVERY_MODE=mock-only
N8N_BASE_URL=http://host.docker.internal:5678
N8N_API_KEY=
N8N_SUPPORTED_VERSION=2.43.6

# Authorized n8n actions (JSON array). Leave empty '[]' for mock-only operation.
# To authorize real recovery, provide tenant_id, integration_id, workflow_id,
# operation, and workflow_sha256 matching the pinned workflow snapshot.
N8N_AUTHORIZATIONS=[]

N8N_CONNECT_TIMEOUT=2
N8N_READ_TIMEOUT=5
N8N_VERIFICATION_SECONDS=15

# ------------------------------------------------------------------------------
# Service Port Bindings
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
TEMPORAL_UI_PORT=8233
