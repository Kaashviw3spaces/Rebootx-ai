DATABASE_URL=postgresql+psycopg://rebootx:local-dev-only@localhost:5432/rebootx
APP_ENV=development
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
MAX_WEBHOOK_BODY_BYTES=65536
# Set a random secret of at least 32 characters here before provisioning.
N8N_WEBHOOK_SECRET=

# Native Temporal development server; remote servers require TLS.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=rebootx-recovery-v1
TEMPORAL_TLS_ENABLED=false
# Set privately only for a remote server using API-key authentication.
TEMPORAL_API_KEY=

# Explicitly opt into Gemma; mock mode never calls an AI API.
AI_PROVIDER=mock
AI_MODEL=gemma-4-26b-a4b-it
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_FALLBACK_ENABLED=true
AI_MIN_CONFIDENCE=0.75
AI_FAST_PATH_ENABLED=true
AI_MAX_OUTPUT_TOKENS=1024
# Optional hosted Gemma 4 control; default omits it from requests.
AI_THINKING_LEVEL=default


# Checkpoint 6: safe defaults. See docs/CHECKPOINT6_DEMO.md before opting in.
RECOVERY_MODE=mock-only
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=
N8N_SUPPORTED_VERSION=
N8N_AUTHORIZATIONS=[]
N8N_CONNECT_TIMEOUT=2
N8N_READ_TIMEOUT=5
N8N_VERIFICATION_SECONDS=15
